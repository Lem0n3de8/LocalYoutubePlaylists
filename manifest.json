{
    "manifest_version": 3,
    "name": "Local YouTube Playlists",
    "version": "0.0.0",

    "description": "An extension that allows you to create playlists without being logged in",

    "browser_specific_settings":{
        "gecko":{
            "id":"local-youtube-playlists@lem0n3de8.org",
            "data_collection_permissions":{
                "required":[
                    "none"
                ]
            }
        }
    },

    "content_scripts":[
        {
            "matches":["*://*.youtube.com/*"],
            "js":["content/content.js"]
        }
    ]
    
}