{
    "manifest_version": 3,
    "name": "Local YouTube Playlists",
    "version": "0.0.0",

    "description": "An extension that allows you to create playlists without being logged in",

    "browser_specific_settings":{
        "gecko":{
            "id":"local-youtube-playlists@lem0n3de8.org",
            "data_collection_permissions":{
                "required":[
                    "none"
                ]
            }
        }
    },

    "web_accessible_resources":[
        {
            "resources": [
                "images/*.png",
                "images/*.svg",
                "content/playlist-ui.css",
                "content/playlist-ui.html"
            ],
            "matches": ["*://www.youtube.com/*"]
        }
    ],
    
    "content_scripts":[
        {
            "matches":["*://www.youtube.com/*"],
            "js":[
                "content/playlist-ui.js",
                "content/content.js"
            ],
            "css": [
                "content/playlist-ui.css",
                "content/content.css"
            ],
            "run_at": "document_end"
        }
    ]
    
}